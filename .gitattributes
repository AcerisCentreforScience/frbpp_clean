# Line endings: the tree is LF; shell scripts must stay LF or bash fails on the shebang.
* text=auto eol=lf
*.sh   text eol=lf
*.py   text eol=lf
*.md   text eol=lf
# Binary catalogue payloads and images are never text-converted
*.p    binary
*.h5   binary
*.npz  binary
*.png  binary
*.tif  binary
*.parquet binary

# Machine-generated data is stored byte-for-byte: its manifest hashes are computed on the
# exact bytes the writer produced, so git must not normalise line endings inside them.
*.csv  -text
*.json -text
*.jsonl -text
*.tsv  -text
*.parquet -text
